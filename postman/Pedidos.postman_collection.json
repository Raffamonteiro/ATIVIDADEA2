{
  "info": {
    "name": "API de Pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "01 - Criar pedido valido (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"Carlos Silva\",\n  \"tipo\": \"entrega\",\n  \"valor\": 350,\n  \"prioridade\": \"normal\"\n}"
        }
      }
    },
    {
      "name": "02 - Criar pedido invalido (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": \"   \",\n  \"tipo\": \"entrega\",\n  \"valor\": -5,\n  \"prioridade\": \"normal\"\n}"
        }
      }
    },
    {
      "name": "03 - Listar pedidos (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        }
      }
    },
    {
      "name": "04 - Consultar pedido existente (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "1"
          ]
        }
      }
    },
    {
      "name": "04b - Consultar pedido inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "999"
          ]
        }
      }
    },
    {
      "name": "05 - Atualizar status valido (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos/1/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "1",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"em_preparacao\"\n}"
        }
      }
    },
    {
      "name": "05b - Atualizar status invalido (400)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos/1/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "1",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"entregue\"\n}"
        }
      }
    },
    {
      "name": "05c - Atualizar status de id inexistente (404)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos/999/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "999",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelado\"\n}"
        }
      }
    }
  ]
}